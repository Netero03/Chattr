# Server
PORT=5000
NODE_ENV=development

# AI rollout flags. Keep all false until provider access and monitoring are ready.
AI_AGENT_ENABLED=false
AI_SMART_REPLIES_ENABLED=false
AI_AUTOCOMPLETE_ENABLED=false

AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=30
AI_REDIS_URL=

# Gemini OpenAI-compatible provider
AI_PROVIDER=gemini-openai-compatible
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL_CHAT=gemini-2.5-flash
AI_MODEL_EMBEDDING=gemini-embedding-001
AI_MAX_CONTEXT_MESSAGES=100
AI_REQUEST_TIMEOUT_MS=15000

# In-memory limiting is suitable for one backend instance. For multiple instances,
# provide a shared adapter through the rate limiter integration and keep these values aligned.